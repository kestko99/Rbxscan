# RoScan Security Platform Configuration
# Copy this file to .env and fill in your actual values

# External Notification Service URL (for security alerts)
DISCORD_WEBHOOK_URL=https://notifications.example.com/api/alerts/YOUR_SERVICE_TOKEN

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=*

# Optional: Database and Analytics
DATABASE_URL=mongodb://localhost:27017/roscan
ANALYTICS_ENABLED=true