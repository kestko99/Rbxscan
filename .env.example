# Environment Variables for RoScan Secure Backend
# Copy this file to .env.local (for Vercel) or configure in Vercel dashboard

# Discord Webhook URL (SECURE - Backend Only)
# This webhook URL is NEVER exposed to the frontend
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Additional security settings
# RATE_LIMIT_REQUESTS_PER_MINUTE=10
# ALLOWED_ORIGINS=https://your-domain.vercel.app,https://your-custom-domain.com